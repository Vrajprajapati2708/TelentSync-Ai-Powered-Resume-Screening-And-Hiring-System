# ============================================================
#  TalentSync / HireAI — Environment Variables Example
#  Copy this file to .env and replace placeholder values.
#  SECURITY WARNING: Never commit real credentials to version control.
# ============================================================

# Application Runtime
FLASK_ENV=production
PORT=5000
SECRET_KEY=replace-with-a-cryptographically-secure-random-string-at-least-32-chars

# Database Configuration (PostgreSQL for Production, SQLite for Dev)
# Production:
DATABASE_URL=postgresql://hireai_user:replace_with_db_password@postgres:5432/hireai_db
# Local Development Fallback:
# DB_FILE=talentsync.db

# Distributed Rate Limiting (Redis)
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Storage Locations (Optional overrides)
# UPLOAD_FOLDER=/app/uploads/resumes
# MODEL_DIR=/app/trained_models

# Email Subsystem (SMTP)
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-smtp-api-key
MAIL_USE_TLS=true
MAIL_FROM=noreply@talentsync.ai
APP_BASE_URL=https://talentsync.ai

# OCR Configuration
OCR_ENABLED=true
OCR_ENGINE=auto
OCR_MAX_PAGES=10
OCR_TIMEOUT_SECONDS=15
OCR_MIN_TEXT_CHARS=50

# Gunicorn Worker Configuration
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ============================================================
#  Live Jobs Provider: Adzuna API
#  Obtain API credentials from https://developer.adzuna.com/
# ============================================================
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in
ADZUNA_TIMEOUT=8
ADZUNA_CACHE_TTL=600
PROVIDER_TIMEOUT=8
PROVIDER_RETRIES=2

